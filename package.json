{
  "name": "@omkar/openchamber-token-meter",
  "version": "1.9.0",
  "private": true,
  "license": "MIT",
  "author": "Omkar Damame",
  "description": "Live tokens-per-second graph and per-session token totals (input, output, reasoning, cache) for the open OpenChamber session.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkardamame/openchamber-token-meter.git"
  },
  "homepage": "https://github.com/omkardamame/openchamber-token-meter#readme",
  "bugs": {
    "url": "https://github.com/omkardamame/openchamber-token-meter/issues"
  },
  "keywords": [
    "openchamber",
    "extension",
    "tokens-per-second",
    "tps",
    "token-usage",
    "cache-hit"
  ],
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "contributes": {
      "panel": {
        "id": "token-meter",
        "name": "Token Meter",
        "icon": "line-chart",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Token meter",
        "height": 148,
        "defaultExpanded": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "opencode"
        ]
      }
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:status && bun run build:service",
    "build:panel": "bunx openchamber-guest-bundle panel/src/main.js panel/main.js",
    "build:status": "bunx openchamber-guest-bundle status/src/main.js status/main.js",
    "build:service": "bunx openchamber-guest-bundle --node service/src/main.js service/main.js",
    "check": "bunx openchamber-guest-check",
    "test": "node scripts/collector-test.mjs",
    "secret-scan": "bash scripts/secret-scan.sh",
    "verify": "bun run build && bun run check && bash scripts/secret-scan.sh && bash scripts/check-changelog.sh && node scripts/collector-test.mjs && node scripts/page-test.mjs",
    "dev": "bash scripts/dev.sh",
    "status-report": "bash scripts/status-report.sh",
    "next-version": "bash scripts/next-version.sh",
    "test:pages": "node scripts/page-test.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.0"
  }
}
